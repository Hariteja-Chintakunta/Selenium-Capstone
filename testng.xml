<!-- ABOUTME: TestNG suite configuration for the saucedemo test automation framework. -->
<!-- ABOUTME: Organizes tests by module with parallel execution and listener support. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Test Suite" parallel="tests" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.capstone.listeners.RetryTransformer"/>
    </listeners>

    <test name="Site Launch Tests">
        <classes>
            <class name="com.capstone.tests.SiteLaunchTest"/>
        </classes>
    </test>

    <test name="Authentication Tests">
        <classes>
            <class name="com.capstone.tests.AuthTest"/>
        </classes>
    </test>

    <test name="Inventory Sorting Tests">
        <classes>
            <class name="com.capstone.tests.InventorySortingTest"/>
        </classes>
    </test>

    <test name="Item Preview Tests">
        <classes>
            <class name="com.capstone.tests.ItemPreviewTest"/>
        </classes>
    </test>

    <test name="Cart Management Tests">
        <classes>
            <class name="com.capstone.tests.CartManagementTest"/>
        </classes>
    </test>

    <test name="Purchase Flow Tests">
        <classes>
            <class name="com.capstone.tests.PurchaseFlowTest"/>
        </classes>
    </test>

    <test name="Burger Menu Tests">
        <classes>
            <class name="com.capstone.tests.BurgerMenuTest"/>
        </classes>
    </test>

    <test name="Full Purchase Journey Tests">
        <classes>
            <class name="com.capstone.tests.FullPurchaseJourneyTest"/>
        </classes>
    </test>
</suite>
