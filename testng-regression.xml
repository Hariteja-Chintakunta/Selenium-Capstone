<!-- ABOUTME: TestNG suite configuration that runs only regression-group tests. -->
<!-- ABOUTME: Use this suite for comprehensive validation of all functionality. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Regression Suite" parallel="tests" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.capstone.listeners.RetryTransformer"/>
    </listeners>

    <test name="Setup Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.SiteLaunchTest"/>
        </classes>
    </test>

    <test name="Login Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.AuthTest"/>
        </classes>
    </test>

    <test name="Product Listing Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.InventorySortingTest"/>
        </classes>
    </test>

    <test name="Product Detail Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.ItemPreviewTest"/>
        </classes>
    </test>

    <test name="Shopping Cart Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.CartManagementTest"/>
        </classes>
    </test>

    <test name="Checkout Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.PurchaseFlowTest"/>
        </classes>
    </test>

    <test name="Navigation Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.BurgerMenuTest"/>
        </classes>
    </test>

    <test name="End-to-End Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.capstone.tests.FullPurchaseJourneyTest"/>
        </classes>
    </test>
</suite>
